notify_arsenal_war_battlefield_result 11166 { # 战场结果
    request {
        .result_data {
            result 0 : integer # 胜利方 1.进攻 2.防守

            .side_data { #  攻防联盟数据
                aid 0 : integer
                kid 1 : integer
                side 2 : integer # 攻防
                info 3 : alliance_brief_info
                .overview {
                    score 0 : integer # 获得分数
                    ctrl_time 1 : integer # 控制时间
                    sum_kill_score 2 : integer # 总杀敌获得分数
                    occupy_score 3 : integer # 控制获得积分
                    pickup_score 4 : integer # 掠夺获得分数
                    collect_score 5 : integer # 采集获得分数
                    def_zombie_count 6 : integer # 防守次数
                }
                overview 4 : overview
                count 5 : integer # 参战人数
                legion_id 6 : integer # 军团编号
            }
            sides 1 : *side_data(side)
            .mvp_data {
                uid 0 : integer
                score 1 : integer
                side 2 : integer
                name 3 : string
                image 4 : integer
                upload_image 5 : string
            }
            mvp 2 : mvp_data # mvp数据
        }
        result 0 : result_data # 战场结果

        .alliance_data {
            side 0 : integer # 联盟所属的攻防方
            add_fraction 1 : integer # 增加的积分
            fraction_new 2 : integer # 目前积分
        }
        alliance 1 : alliance_data # 所属联盟数据
        
        .player_data {
            .value_struct {
                value 0 : integer # 值
                avg 1 : integer # 平均
                max 2 : integer # 最大值
                is_new_record 3 : boolean # 是否新纪录
            }
            score 0 : value_struct # 积分
            kill_num 1 : value_struct # 杀敌数
            wound_num 2 : value_struct # 伤病数
            heal_num 3 : value_struct # 治疗数
            kill_score 4 : value_struct # 杀敌积分
            occupy_score 5 : value_struct # 控制积分
            pickup_score 6 : value_struct # 掠夺积分
            collect_score  7 : value_struct # 采集积分
        }
        player 2 : player_data  # 玩家个人数据
    }
}


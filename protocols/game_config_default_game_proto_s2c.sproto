		president_data 0 : president_data
		is_full 1 : boolean # 是否全量数据
	}
}

notify_capital_war_watch_info 10958 { #更新占领信息
	request {
		aid 0 : integer(0) #当前占领联盟ID
		abbr 1 : string #当前占领联盟简称
		aname 2 : string #当前占领联盟名称
		points 3: integer(0) #个人积分
		is_full 4: boolean #是否全量数据

		.del {
			aid 0 : boolean 			# 当前占领联盟ID
			abbr 1 : boolean 			# 当前占领联盟简称
			aname 2 : boolean 			# 当前占领联盟名称
			occupy_info 6 : boolean		# 占领信息
			flag 7 : boolean
			flag_bg 8 : boolean
		}

		del 5: del #删除KEY
		rank 6 : integer #个人积分排名
		.sit_info {
			score 0 : integer	# 已经占领的时间
			time 1 : integer	# 最后坐下的时间
			abbr 2 : string			# 联盟简称
			aname 3 : string		# 联盟名字
			aid 4 : integer(0)     # 联盟ID
		}
		occupy_info 10 : *sit_info	# 占领信息
		flag 11 : integer
		flag_bg 12 : integer
		nick_name 13 : string
		occupied_kid 14 : integer

		.winner_info { # 最终胜利者数据
			is_cross_mode 0 : boolean #是否跨服模式
			kid 1 : integer #国王kid
			abbr 2 : string #联盟简称
			nickName 3 : string #国王名字
			aname 4 : string #联盟名字
		}
		winner_info 15 : winner_info
	}
}

notify_capital_war_win 10959 { #通知获胜联盟成员(同步选举信息)
	request {
		elect_endtime 0 : integer #选举结束时间
		president 1 : integer
		is_cross_mode 2 : boolean #是否跨服模式
		vassal_kid 3 : integer # 附属国kid
	}
}

notify_capital_war_office_init 10960 { # 官职数据初始化
	request {
		red_dot 0 : *capital_war_application_info() # 用于红点, key=官职ID, value=最大的申请时间戳
		apply_info 1 : *capital_war_apply_info(id)
		.agree_info {
			id 0 : integer
			auto_agree 1 : boolean # 是否自动同意
			only_native 2 : boolean # 是否仅同意本国	
		}
		auto_agree_map 3 : *agree_info(id) # 自动同意的设置情况, key=官职ID
	}
}

notify_capital_war_new_application 10961 { # 新的官职申请或者自动同意状态变化 只有国王和内政部长会收到
	request {
		office 0 : integer
		new 1 : capital_war_application_info # 新的申请
		auto_agree 2 : boolean # 此字段存在时,表示自动同意状态发生变化
		# 当前存在的最新申请(注: 申请过期删除时不会发这个字段), 申请列表为空时, 此字段内容为{ ts = 0}
		change 3 : capital_war_application_info
		only_native 4 : boolean # 是否仅同意本国
	}
}

notify_capital_war_office_watch_data 10962 { # 官职watch数据
	request {
		is_full 0 : boolean # 是否全量
		uid 1 : integer # 当前任职玩家
		appoint_ts 2 : integer(0) # 最近一次任职时间

		.info {
			uid 0 : integer
			ts 1 : integer(0) # 加入排队的时间
		}
		list 3 : *info # 全量时此字段才有意义

		.change_info {
			uid 0 : integer
			opt 1 : integer  #0 新增, 1 删除, 2 置顶
			# 在队列中的位置
			# 新增时: 表示插入到队列后的位置, 即末尾
			# 删除时: 表示删除前所在的位置
			# 置顶时: 表示置顶前所在的位置
			idx 2 : integer 
			ts 3 : integer(0) # 加入排队的时间, 新增时自字段才有意义
		}
		change 4 : change_info
		dismiss 5 : boolean # 解雇当前玩家
		office 6 : integer # 官职ID
	}
}


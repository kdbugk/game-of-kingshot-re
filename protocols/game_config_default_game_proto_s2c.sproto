.quest {
    id 0 : integer  #任务id
    progress 1 : integer            #任务进度
}
.finishs {
    id 0 : integer  #任务id
    isgetaward 1 :  boolean          #是否领奖
}

.question_info {
    id 0 : integer     # 问卷ID
    trigger 1 : integer  # 触发时间
    answer 2 : boolean # 是否填写问卷
}


.queue {
    .base {
        qtype           1 : integer     # 队列类型 1:建筑队列
        purchased_endtime 2 : integer   # 队列到期时间，-1表示永久有效
        first_activion    3 : boolean   # 是否首次激活动
    }

    qid                 0 : integer     # 队列唯一id
    base                1 : base
    status              2 : integer     # 队列状态

    end_time            3 : integer     # 队列当前任务结束时间
    total_time          4 : integer     # 队列当前任务总时间

    help_id             5 : integer     # 是否请求过联盟帮助(有值即请求过帮助)
}



.ramadan_quest_info {
    finishs 0 : *finishs()                      # 已领奖任务
    quests 1 : *quest()                         # 未完成有进度的任务
}

.ramadan_share_id {
	share_id 0 : integer(0)
	is_get 1 : boolean
}

.ramadan_info {
	id 0 : integer                              # 活动ID
	stage_ts 1 : *integer						# 活动阶段时间数组 [1]预告开始 [2]活动开始 [3]展示阶段开始 [4]活动结束
    serial_no 2 : integer

	quest_info 3 : ramadan_quest_info			# 任务数据

	last_reset_time 4 : integer					# 上次重置时间
	hope_progress 5 : integer					# 祈福进度
	is_get_progress_reward 6 : boolean			# 是否领取祈福进度奖励

	get_share_id_lst 7 : *ramadan_share_id()	# 领取的分享列表 {[id] = true}

	free_hope_nums 8 : integer					# 免费祈福的次数
}

.ramadan_hope_share_info { 						# 分享到联盟的祈福奖励信息
	share_id 0 : integer(0)						# 分享id
	uid 1 : integer								# 分享者id
	share_time 2 : integer 						# 分享时间
}



.rank_data {     # 排行榜数据
    key 0 : integer     # 唯一标识
    value 1 : *integer(0)  # 排行榜的数据
    # 普通排行榜 value 第一个值为排序数值,第二个值为时间
}

.extra_rank_data { # 额外排行榜数据，用于零散排名数据展示
    rank 0 : integer # 排行
    data 1 : rank_data
}

.rank_info {
    type 0 : integer(0)         # 排行类型
    ext 1 : rank_ext
    top 2 : rank_data           # 排名第一的数据
    self_rank 3 : integer       # 自己的排名
    count 4 : integer           # 排行榜记录总数
    self_value 5 : *integer(0)  # 自己的数据，同rank_data.value
}

.rank_ext {
    aid 1 : integer
    rank_id 2 : integer
}

.rank_type {
    type 0 : integer(0)
    ext 1 : rank_ext
}



.recharge_data { 	# 购买数据
    id 0 : integer
    .buy_data {
        count 0 : integer
        time 1 : integer
    }
    day_data 1 : buy_data
    first_data 2 : buy_data
}



.recon_player_base {
    uid 0 : integer
    lv 1 : integer
    nickName 2 : string
    image 3 : integer

.birthday_customize_item {
    boxid           0 : integer   #格子id  
    items           1 : *item()
}

.birthday_reward_info { # 生日奖励数据
    year            0 : integer # 生日年
    stove_lv        1 : integer # 生日时的熔炉等级
    reward_id       2 : integer # 奖励id
    expire_time     3 : integer # 过期时间
    privilege_mark  4 : *pair_int_bool() # {[奖励类型]=true} 标示玩家当前有哪些奖励 奖励类型：1-免费 2-自选
    is_get          5 : *pair_int_bool() # 是否领取 奖励类型：1-免费 2-自选
    customize_item  6 : *birthday_customize_item() # 自选道具
}

.super_vip {
    join_time               0 : integer # 加入会员的时间
    join_reward_expire_time 1 : integer # 加入会员的奖励过期时间
    is_get_join_reward      2 : boolean # 是否领取加入奖励
    last_birthday_gift_time 3 : integer # 生日礼包上次触发时间
    next_birthday_gift_time 4 : integer # 下次生日礼包触发时间
    is_vip                  5 : boolean # 是否会员
}

.super_vip_set_info {
    is_set                  0 : boolean # 是否设置过 只要设置过 玩家无法修改生日和邮箱

    set_time                1 : integer # 设置的时间 只要不是同一天 设置次数就可以重置
    today_set_count         2 : integer # 今日设置次数

    .birthday_date {
        month               0 : integer
        day                 1 : integer
    }

    birthday                3 : birthday_date
    mail                    4 : string
    discord                 5 : string
    gender                  6 : integer # 1-男性 2-女性 3-第三性别
}


# 幸存者
.survivor {
    sid             0 : integer     # 工人id
    status          1 : integer     # 工人状态(空闲、工作、生病...)
    fid_source      2 : integer     # 工人绑定宿舍床位
    fid_work        3 : integer     # 工作工位家具id
    fid_ibed        4 : integer     # 医务室病床 bed
    cure_end_time   5 : integer     # 治疗结束时间
    img_id          6 : integer     # 形象id
    name_id         7 : integer     # 名字索引
    total_cure_time 8 : integer     # 生病总时间
    is_sick         9 : boolean     # 是否生病
}

.riot_data {
    start_time 0 : integer          # 暴动开始时间，一次都没暴动过是nil，暴动结束不会清
    detect_time 1 : integer         # 上次检测暴动时间，一次都没检测过是nil
}

.survivor_sick_result {
    sid             0 : integer     # 工人id
    fid_ibed        1 : integer     # 生病时如果有分配医院床位，则上传床位fid
    cure_end_time   2 : integer     # 生病时指定治疗结束时间
    total_cure_time 3 : integer     # 生病总时间
    health          4 : double      # 健康值（client_survivor_data.res607）
}



.target_integral_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer         # 活动开始时间
    end_ts 2 : integer           # 活动结束时间
    integral 3 : integer         # 当前积分
    
    .received_mark {
        id 0 : integer # 奖励档位
        value 1 : boolean #是否被领取
    }
    received 4 : *received_mark() #已领取的奖励
    reward_conf_idx 5 : *integer #每个阶段奖励的配置ID(索引target_integral_reward表), 按阶段顺序排序, 1阶段的配置ID就是数组的第一个元素
    act_conf_id 6 : integer # 索引target_activity_conf
}



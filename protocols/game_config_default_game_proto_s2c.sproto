    soldier_info 2 : *battle_soldier(id)    # 士兵数量
    equipment_info 3 : *lords_equipment_map()     # 领主装备信息
    extra 4 : recon_formation_extern        # 不同类型队列的个性化数据
}

.recon_tech_info {
    buff_map 0 : *pair_int_int()        # 科技buff
}

.recon_report {
    playerinfo 0 : recon_player_base        # 玩家基础
    city_info 1 : recon_city_info           # 城堡信息
    formation_list 2 : *recon_formation_info    # 防守部队列表
    buff_map 3 : *pair_int_int()            # buff
}



.recover_resource { 	        # 恢复资源
	id 0 : integer		        # ID
	count 1 : integer(1)	    # 值
	next_calc_ts 2 : integer(1) # 下次计算时间
    recover 3 : integer         # 恢复值
    interval 4 : integer        # 恢复间隔
    max_count 5 : integer(1)    # 恢复上限
}



.recruitment_data {
    loyalty 0 : integer             # 忠诚值
    last_collect_ts 1 : integer     # 上次立即招募时间
    recover_speed 2 : double        # 恢复速度
}

.loyalty_supply_data {
    stove_lv 0 : integer            # 触发的火炉等级
    expire_ts 1 : integer           # 过期时间
    get_reward 2 : boolean          # 是否已经领奖
}


.online_reward {
    receive_start_time  0 : integer # 下次可领取奖励时间
    online_reward       1 : *item
    day_count           2 : integer # 当日已领取的在线奖励的次数
    online_unlock_show  3 : boolean
}

.spec_reward {
    # spec_reward         0 : *item
    receive_time        0 : integer # 上一次的领取时间
}

.bank {
    .use_locker {
        locker_id       0 : integer  # 柜子id
        amount          1 : integer  # 储存的钻石数量
        expire_time     2 : integer  # 储存到期时间
    }
    unlock_locker       0 : *integer # 银行解锁的储物柜
    use_locker          1 : use_locker # 银行正在使用中的储物柜
}


# 请求作息表数据
req_schedule_info 3301 {
    request {
    }
    response {
        qtime_id            0 : integer # 当前处于该作息表的时间段索引
        start_time          1 : integer # 当前时间段起始时间对应的真实时间戳
        server_time         2 : integer # 服务器时间
    }
}


.researched {
    tid 0 : integer            #科技ID（不带等级）
    lev 1 : integer            #已研究等级  *开始研究时 lev = 0
}

.researchinginfo {
    endtime 0 : integer    #研究结束时间
    qid 1 : integer        #队列id
    cost_time 2 : integer  #消耗时间
}

.researching {
    tid_lev 0 : integer  #科技ID（带等级）
    endtime 1 : researchinginfo   #研究中科技信息
}

.set_info {
    id 0 : integer
    dataInt 1: integer
    dataString 2: string
}

.notify_info {
    type 0 : integer        # 推送类型
    value 1 : integer       # 设置的值
}

.bind_info { # 删档测试账号绑定
    .test_account {
        amount 0 : integer(2) # 充值金额(配置的价格)
    }
    account 0 : test_account # 测试账号信息(nil表示无测试信息)
    time 1 : integer(0) # 绑定时间
    received 2 : *pair_int_bool() # 已领取信息{[天数] = 是否已领取}
    is_get_return_reward 3 : boolean # 是否领取回归奖励
}


.scord_award{
    index 0 : integer  #索引
    get_sate 1 : integer            #领取状态   =  1 (领取普通奖励) =  2（也领取了vip奖励） 
}



# 家具通用结构
.furniture {
    .base {
        conf_fid    0 : integer     # 家具配置表的fid
        type        1 : integer     # 家具类型
        lv          2 : integer     # 家具等级
    }

    fid             0 : integer     # 家具id，服务器生成
    base            1 : base        # 基础数据

    #sid             2 : integer     # 该家具工位工作的幸存者
    work_endtime    3 : integer     # 工作结束时间(猎人工具才有，每个work周期只能工作一次)
    remaining_mti   4 : integer     # 工作时长剩余不够生产一个单元资源的部分(毫秒)
    sid_list        5 : *integer    # 宿舍-床 的幸存者
    output_after_buff 6 : integer   # 单位时长产出
}

# 建筑通用结构
.building {
    .base {
        lv          0 : integer     # 建筑等级
        status      1 : integer     # 建筑状态
        furniture   2 : *furniture(fid) # 建筑家具数据
        mode        3 : integer     # 建筑模式 1:攻击 2:防御 
    }

    bid         0 : integer     # 建筑地块id
    base        1 : base        # 基础数据
    qid         2 : integer     # 建造或升级队列id

    # 特定建筑数据，大熔炉数据
    switch      4 : integer     # 燃烧开关设置 0:关闭 1:打开
    overdrive   5 : integer     # 过载开关设置 0:关闭 1:打开
    # 厨房数据
    foods       6 : *integer    # 现有食物id数组
    production_food_id 7 : integer  # 制作的食物

    # 防御塔数据
    pattern_id 8 : integer # 形态id
}



.goods {                    # 商品
    id 0 : integer          # 商品id
    conf_id 1 : integer     # 商品配置id
    buy_count 2 : integer   # 已购买数量
}

.shop { 	                    # 商店
	id 0 : integer
    goods 1 : *goods(id)        # 商品列表
    last_refresh_ts 2 : integer # 上次自动刷新时间
    refresh_times 3 : integer   # 已刷新次数
    first_refresh_time 4 : integer #刷新周期内 第一次刷新时间
}




.sign_draw_info {
    id 0 : integer                              # 活动ID
    start_ts 1 : integer                        # 活动开启时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer                       # 活动序列号

    sign_progress 4 : integer                   # 签到进度
    sign_progress_reward 5 : *pair_int_bool()   # 已领取签到奖励 {[progress]=true}

    pool_id 6 : integer                         # 奖池id

    free_lottery_nums 7 : integer               # 免费抽奖次数

    is_unlock_sign 8 : boolean                  # 是否解锁签到
}

.sign_draw_reward {
    idx 0 : integer                             # 抽奖次数
    reward 1 : *item()
}



.skintype{
    id 0 : integer #皮肤类型
    equip 1 : integer # 装备的id nil or 0 为默认
    skins 2 : *skin(id)
}

.skin{
    id 0 : integer #皮肤id
    expire_ts 1 : integer   # 到期时间

    exclusive_equipemnt 6 : exclusive_equipment_info #专属装备信息
    training_lv 7 : integer
}

.recon_hero_equip_info{
    skill 0 : *pair_int_int()   #slg 技能 (专属装备技能)
    equip_detail 1 : *equip_detail_info(uid)  #英雄装备(有uid)
}

.recon_formation_extern {
    # 联盟建筑用
    build_speed 0 : double      # 建造速度
    destroy_speed 1 : double    # 破坏速度
    glory_speed 2 : double      # 荣誉获得速度
    mass_soldier_max_num 3 : integer # 集结士兵上限
    mass_member_max 4 : integer # 集结部队数上限
    troop_limit 5 : integer     # 士兵上限
}

.recon_formation_info {
    playerinfo 0 : recon_player_base        # 部队拥有者信息

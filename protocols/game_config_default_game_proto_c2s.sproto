        }
        .cell {
            atk 0 : owner       # 进攻方
            def 1 : owner       # 防守方
            res 2 : integer     # 结果 1.战胜 2.战败 3.援军
            time 3 : integer    # 时间
        }
        .map_cell {
            idx 0 : integer     # 索引号
            cell 1 : cell
        }
        list 3 : *map_cell()
    }
}


req_begin_adventure_pve 1501 { #  开始挑战
	request {
        checkpoint 0 : integer
        fight_heros_data 1 : fight_heros_data  #参战英雄列表
	}
	response {
		code 0 : integer
        battle_troops_info 1: battle_troops_info #部队信息
        is_fast 2 : boolean                     # 是否快速探险
        hang_start_time 3 : integer             # 领奖时间
        clear_reward 4 : *item()                # 清除奖励
    }
}

req_end_adventure_pve 1502 { # 完成挑战
    request {
        .enddata {
            index 0 :  integer #单位索引
            hp 1 :  integer #剩余血量
        }
        checkpoint 0 :  integer
		operatedata 1 :  *operatedata()      #战斗数据  
        enddata  2 : *enddata
        version 3 : integer # 战斗数据版本号（客户端）
	}
	response {
		code 0 : integer
        is_win 1 : boolean  #胜利标志
		hang_start_time 2 : integer    #领奖时间
        clear_reward 3 : *item() #清除奖励
	}
}

req_get_hang_up_reward 1503{ #领取挂机收益
    response {
		code 0 : integer
        hang_start_time 1 : integer    #挂机开始时间
        current_reward 2 : *hungs_awards()          # 领取的挂机奖励
    }
}

req_open_hang_up_reward_view 1504{ #打开挂机奖励
    response {
		code 0 : integer

req_alliance_showdown_reorganize_way 9846 { # R4/R5调整分路
	request {
		from 0 : integer # 分路ID
		to 1 : integer # 移动到分路ID
		order 2 : *integer # 旧的分路信息(用于校验是否有其他人修改)
	}
	response {
		code 0 : integer # 错误码7710和0时, 返回下面参数
		alliance 1 : showdown_alliance # 本联盟最新阵容信息 校验order失败也会返回
	}
}

req_alliance_showdown_change_player_way 9847 { # R4/R5调整单个玩家分路
	request {
		from 0 : integer # 分路ID
		to 1 : integer # 移动到分路ID
		order 2 : *integer # 旧的分路信息(用于校验是否有其他人修改)
		uid 3 : integer # 被炒作的玩家uid
	}
	response {
		code 0 : integer # 错误码7710和0时, 返回下面参数
		list 1 : *showdown_group_player # 最新分路信息
		.player_apply {
			type 0 : integer # 分路(1,2,3)
			formation 1 : formation_build #编队
		}
		player 2 : player_apply # 玩家自己报名信息
		order 3 : *integer # 分路顺序 为nil默认{1,2,3}
		alliance 4 : showdown_alliance # 本联盟最新阵容信息 校验order失败也会返回
	}
}

req_alliance_showdown_operate_records 9848 { # 获取操作记录
	response {
		code 0 : integer
		.record {
			type 0 : integer # 类型 1.调整分路 2.调整玩家
			uid 1 : integer # 操作玩家
			from 2 : integer # 从分路ID
			to 3 : integer # 移到到分路
			target_uid 4 : integer # 被操作的玩家(type=2)
			time 5 : integer(0) # 时间
			name 6 : string # 操作玩家名称
			target_name 7 : string # 被操作玩家名称(type=2)
		}
		records 1 : *record
	}
}


	}

	response {
		code 0 : integer
		.history {
			index 0 : integer # 编号
            .camp_data { #  三个阵营数据
                aid 0 : integer
                kid 1 : integer
                camp 2 : integer # 阵营
				score 3 : integer # 积分
				legion 4 : integer # 军团编号
                abbr 5 : string # 简称
                aname 6 : string # 全称
                flag 7: integer # 旗帜
                flag_bg 8 : integer # 旗帜背景
            }
            camps 1 : *camp_data
			starttime 2 : integer(0) # 开始时间
            endtime 3 : integer(0) # 结束时间
			.mvp_data {
                uid 0 : integer
                aid 1 : integer
                name 2 : string
                image 3 : integer
                upload_image 4 : string
                
            }
			mvp 4 : mvp_data # mvp数据
		}
		list 1 : *history # 历史数据列表
	}
}


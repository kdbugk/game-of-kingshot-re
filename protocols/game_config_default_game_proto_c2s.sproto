req_icebound_amazing_open_chest  13251 {     # 开启宝箱
    request {
        ids 0 : *integer
        activity_id 1 : integer     # 活动id
    }

    response {
        code 0 : integer
        chest_progress 1 : integer              # 宝箱进度
        .reward {
            id 0 : integer
            item 1 : *item()
        }
        items 2 : *reward()
    }
}

req_icebound_amazing_refresh  13252 {     # 刷新宝箱
    request {
        activity_id 0 : integer     # 活动id
    }

    response {
        code 0 : integer
        chest 1 : *map_chest()                  # 宝箱数据
        refresh_time 2 : integer                    # 上次刷新时间
    }
}



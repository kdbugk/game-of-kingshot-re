# 触发信件
req_trigger_opinion 8501 {
    request {
        type            0 : integer     # 信件类型(建筑、心情...)
        sid             1 : integer     # 信件来源幸存者
        content_id      2 : integer     # 信件内容配置表id
        choice_id       3 : integer     # 紧急信件选项id
        is_anonymity    4 : boolean     # 是否匿名
    }
    response {
        code            0 : integer
    }
}

# 信件处理，紧急事件选择完才算处理；回信打开就算处理
req_process_opinion 8502 {
    request {
        ids             0 : *integer    # 普通信件可能同时请求多封一起处理(此时不是紧急信件，没有select_id)
        select_id       1 : integer     # 处理紧急信件时的选择id      
    }
    response {
        code            0 : integer
        fail_ids        1 : *integer    # 如果有处理失败的，返回失败列表
    }
}


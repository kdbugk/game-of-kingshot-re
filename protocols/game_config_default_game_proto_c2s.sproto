req_world_march 5701 {
    request {
        .extra {
            monsterid 0 : integer # 怪物id 出征类型 3
            prepare_time_index 1 : integer #集结准备时间选项
            master_marchid 2 : integer #集结主队列
            event_id 3 : integer        # 事务唯一id
            param1 4 : integer          # 参数1, 捕捉宠物时带上怪物类型 mapobj_type
        }

        type 0 : integer #出征类型
        endpoint 1 : point #终点
        formation 2 : formation_build #编队
        extra 3 : extra # 其他参数
    }
    response {
        code 0 : integer
        march_info 1 : world_march
    }
}


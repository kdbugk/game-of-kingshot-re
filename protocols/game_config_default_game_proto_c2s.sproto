    }
    response {
        code 0 : integer
        level_id 1 : integer                    # 关卡id
        fish_info 2 : *fishing_fish_info        # 关卡生成的鱼信息
        random_key 3 : string                   # 关卡随机key 结算关卡时当做内容做加密使用
    }

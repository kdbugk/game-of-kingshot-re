# 请求自动加入
req_alliance_activity_auto_join_info 10001 {
    request {
        auto_mass_id_list    0 : *integer    # 自动集结列表
    }
    response {
        .auto_mass_info {
            id              0 : integer
            #count           1 : integer     # 奖励次数
            selected        2 : boolean     # 是否选中
        }

        code            0 : integer
        end_time        1 : integer     # 自动加入结束时间
        pos             2 : integer     # 列表中所处的位置
        just_soldier    3 : boolean     # 加入类型，true:单兵加入、false/nil:整编
        auto_mass_list  4 : *auto_mass_info(id)
    }
}

# 开启自动加入
req_alliance_activity_auto_join_open 10002 {
    request {
        just_soldier        0 : boolean     # 加入类型，true:单兵加入、false/nil:整编
        auto_mass_id_list   1 : *integer    # 勾选的自动集结列表
    }
    response {
        code                0 : integer
        end_time            1 : integer     # 自动加入结束时间
        pos                 2 : integer     # 列表中所处的位置
    }
}

# 关闭自动加入
req_alliance_activity_auto_join_close 10003 {
    response {
        code                0 : integer
    }
}





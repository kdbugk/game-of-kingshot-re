#调用此接口时会通过notify_fortune_card_winning_records(100条中奖记录)通知最近中奖记录
watch_fortune_card_winning_info 11006 {
	request {
		id 0 : integer # 活动ID
		record_id 1 : integer(0) # 记录ID
	}
	response {
		
	}
}

#响应watch推送
#每次收到notify_fortune_card_winning_records时都要向服务器发送这条协议, 否则
#watch的监听将终止, 后续新的中奖记录都不会通知给客户端
rsp_watch_fortune_card_winning_info 11007 {
	request {
		id 0 : integer # 活动ID
	}
	response {
		
	}
}




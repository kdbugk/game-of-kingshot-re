req_alliance_player_rank_data 5401 { # 玩家捐献数据
	request {
		type 0 : integer # 排行榜id 20001:日捐献 20002:周捐献 20011:日活跃 20012:周活跃
	}

	response {
		code 0 : integer
		.rank_data {
			rank 0 : integer # 排名
			value 1 : integer # 捐献值
		}
		rank_data 1 : rank_data
	}
}

req_alliance_rank_data 5402 { # 联盟排行榜数据
	request {
		type 0 : integer # 排行榜id 20001:日捐献 20002:周捐献 20011:日活跃 20012:周活跃 10001:历史捐献 10002:历史活跃
		season 1 : integer
	}

	response {
		code 0 : integer
		.rank_data {
			key 0 : integer # uid
			value 1 : *integer # 捐献值,时间,联盟荣耀
		}
		rank_list 1 : *rank_data # 有积分上榜的成员，已有序
		.join_info {
			key 0 : integer
			join_time 1 : integer # 效率问题已弃用
		}
		join_info 2 : *join_info(key) # 未上榜成员(无序)，提供其它数据方便客户端排序(服务端排序耗时较大)
	}
}


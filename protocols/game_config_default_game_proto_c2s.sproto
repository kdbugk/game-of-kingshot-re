req_fishing_end_level 13504 {   # 结束关卡
    request {
        id 0 : integer                          # 活动ID
        item 1 : *fishing_fish_info             # 勾到的物件 包括鱼,宝箱,纪念品,潜水员
        use_protection_device_count 2 : integer # 使用保护装置次数
        max_depth 3 : integer                   # 到达的最大深度
        total_time 4 : integer                  # 关卡总时间
        token 5 : string                        # token 对item和关卡随机数的加密字符串
        dun_data 6 : string                     # 易盾数据
    }
    response {
        code 0 : integer
        coin 1 : integer                        # 获得的金币
        integral 2 : integer                    # 获得的积分
        event_id 3 : integer                    # 潜水员事件id
        handbook_items 4 : *integer             # 新获得的图鉴物件id列表
        diver_id 5 : integer                    # 潜水员id
        over_max_depth 6 : boolean              # 本次是否超过历史最高深度
        over_max_coin 7 : boolean               # 本次是否超过历史最高金币
        over_max_integral 8 : boolean           # 本次是否超过历史最高积分
        diver_total_addition 9 : integer        # 潜水员总加成
        sdk_resp_data 10 : string
    }
}

req_fishing_take_handbook_reward 13506 {   # 领取图鉴奖励
    request {

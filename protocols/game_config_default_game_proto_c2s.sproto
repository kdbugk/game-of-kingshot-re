    extra 4 : recon_formation_extern        # 不同类型队列的个性化数据
}

.recon_tech_info {
    buff_map 0 : *pair_int_int()        # 科技buff
}

.recon_report {
    playerinfo 0 : recon_player_base        # 玩家基础
    city_info 1 : recon_city_info           # 城堡信息
    formation_list 2 : *recon_formation_info    # 防守部队列表
    buff_map 3 : *pair_int_int()            # buff
}



.recover_resource { 	        # 恢复资源
	id 0 : integer		        # ID
	count 1 : integer(1)	    # 值
	next_calc_ts 2 : integer(1) # 下次计算时间
    recover 3 : integer         # 恢复值
    interval 4 : integer        # 恢复间隔
    max_count 5 : integer(1)    # 恢复上限
}



.recruitment_data {
    loyalty 0 : integer             # 忠诚值
    last_collect_ts 1 : integer     # 上次立即招募时间
    recover_speed 2 : double        # 恢复速度
}

.loyalty_supply_data {
    stove_lv 0 : integer            # 触发的火炉等级
    expire_ts 1 : integer           # 过期时间
    get_reward 2 : boolean          # 是否已经领奖
}


.online_reward {
    receive_start_time  0 : integer # 下次可领取奖励时间
    online_reward       1 : *item
    day_count           2 : integer # 当日已领取的在线奖励的次数
    online_unlock_show  3 : boolean
}

.spec_reward {
    # spec_reward         0 : *item
    receive_time        0 : integer # 上一次的领取时间
}

.bank {
    .use_locker {
        locker_id       0 : integer  # 柜子id
        amount          1 : integer  # 储存的钻石数量
        expire_time     2 : integer  # 储存到期时间
    }
    unlock_locker       0 : *integer # 银行解锁的储物柜
    use_locker          1 : use_locker # 银行正在使用中的储物柜
}


# 请求作息表数据
req_schedule_info 3301 {
    request {
    }
    response {
        qtime_id            0 : integer # 当前处于该作息表的时间段索引
        start_time          1 : integer # 当前时间段起始时间对应的真实时间戳
        server_time         2 : integer # 服务器时间
    }
}


.researched {
    tid 0 : integer            #科技ID（不带等级）
    lev 1 : integer            #已研究等级  *开始研究时 lev = 0
}

.researchinginfo {
    endtime 0 : integer    #研究结束时间
    qid 1 : integer        #队列id
    cost_time 2 : integer  #消耗时间
}

.researching {
    tid_lev 0 : integer  #科技ID（带等级）
    endtime 1 : researchinginfo   #研究中科技信息
}

.set_info {
    id 0 : integer
    dataInt 1: integer
    dataString 2: string
}

.notify_info {
    type 0 : integer        # 推送类型
    value 1 : integer       # 设置的值
}

.bind_info { # 删档测试账号绑定
    .test_account {
        amount 0 : integer(2) # 充值金额(配置的价格)
    }
    account 0 : test_account # 测试账号信息(nil表示无测试信息)
    time 1 : integer(0) # 绑定时间
    received 2 : *pair_int_bool() # 已领取信息{[天数] = 是否已领取}
    is_get_return_reward 3 : boolean # 是否领取回归奖励
}


.scord_award{
    index 0 : integer  #索引
    get_sate 1 : integer            #领取状态   =  1 (领取普通奖励) =  2（也领取了vip奖励） 
}



# 家具通用结构
.furniture {
    .base {
        conf_fid    0 : integer     # 家具配置表的fid
        type        1 : integer     # 家具类型
        lv          2 : integer     # 家具等级
    }

    fid             0 : integer     # 家具id，服务器生成
    base            1 : base        # 基础数据

    #sid             2 : integer     # 该家具工位工作的幸存者
    work_endtime    3 : integer     # 工作结束时间(猎人工具才有，每个work周期只能工作一次)
    remaining_mti   4 : integer     # 工作时长剩余不够生产一个单元资源的部分(毫秒)
    sid_list        5 : *integer    # 宿舍-床 的幸存者
    output_after_buff 6 : integer   # 单位时长产出
}

# 建筑通用结构
.building {
    .base {
        lv          0 : integer     # 建筑等级
        status      1 : integer     # 建筑状态
        furniture   2 : *furniture(fid) # 建筑家具数据
        mode        3 : integer     # 建筑模式 1:攻击 2:防御 
    }

    bid         0 : integer     # 建筑地块id
    base        1 : base        # 基础数据
    qid         2 : integer     # 建造或升级队列id

    # 特定建筑数据，大熔炉数据
    switch      4 : integer     # 燃烧开关设置 0:关闭 1:打开
    overdrive   5 : integer     # 过载开关设置 0:关闭 1:打开
    # 厨房数据
    foods       6 : *integer    # 现有食物id数组
    production_food_id 7 : integer  # 制作的食物

    # 防御塔数据
    pattern_id 8 : integer # 形态id
}



.goods {                    # 商品
    id 0 : integer          # 商品id
    conf_id 1 : integer     # 商品配置id
    buy_count 2 : integer   # 已购买数量
}

.shop { 	                    # 商店
	id 0 : integer
    goods 1 : *goods(id)        # 商品列表
    last_refresh_ts 2 : integer # 上次自动刷新时间
    refresh_times 3 : integer   # 已刷新次数
    first_refresh_time 4 : integer #刷新周期内 第一次刷新时间
}




.sign_draw_info {
    id 0 : integer                              # 活动ID
    start_ts 1 : integer                        # 活动开启时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer                       # 活动序列号

    sign_progress 4 : integer                   # 签到进度
    sign_progress_reward 5 : *pair_int_bool()   # 已领取签到奖励 {[progress]=true}

    pool_id 6 : integer                         # 奖池id

    free_lottery_nums 7 : integer               # 免费抽奖次数

    is_unlock_sign 8 : boolean                  # 是否解锁签到
}

.sign_draw_reward {
    idx 0 : integer                             # 抽奖次数
    reward 1 : *item()
}



.skintype{
    id 0 : integer #皮肤类型
    equip 1 : integer # 装备的id nil or 0 为默认
    skins 2 : *skin(id)
}

.skin{
    id 0 : integer #皮肤id
    expire_ts 1 : integer   # 到期时间
}

.skin_slat_detail {
    skintype 0 : integer
    id 1 : integer
    expire_ts 2 : integer   # 到期时间
}


.snow_fund_bp {
    .received_mark {
        type 0 : integer # 奖励类型 1免费 2普通付费
        value 1 : *pair_int_bool()
    }
    received_mark 0 : *received_mark()
    privilege_mark 1 : *pair_int_bool() # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
}

.snow_fund_info {
    buy 0 : boolean                     # 是否已购买基金
    bp_info 1 : snow_fund_bp            # 通行证数据
}

.snow_guide{
	id 0: integer
	trigger_time 1 : integer # 触发时间（new任务）
	snow_time 2 : integer  #开始下雪时间 （发邮件）
	quests 3 :  *quest(id)   #任务 （手动领奖/发过邮件 quests = {})
	manual_getaward 4 : integer # 是否手动领奖
}



.social_info {
    id 0 : integer
    is_open 1 : boolean     # 是否点开
    is_receive 2 : boolean  # 是否领取
}



.formation_build_pair {
    id 0 : integer
    prefab 1 : formation_build
}





.spar_laboratory_gift { # 礼包
    id 0 : integer # 礼包ID
    count 1 : integer # 购买次数
}

.spar_laboratory_quest { # 任务
    id 0 : integer # 任务ID
    count 2 : integer # 完成次数
    receive_count 3 : integer # 已领取次数
}

.spar_laboratory_exchange { # 兑换
    id 0 : integer # 兑换ID
    count 1 : integer # 兑换次数
}

.spar_laboratory_activity { # 活动数据
	id 0 : integer # 活动ID 
	starttime 1 : integer # 开始时间
	endtime 2 : integer # 赛季结束时间
    quests 3 : *spar_laboratory_quest(id) # 任务数据
    gifts 4 : *spar_laboratory_gift(id) # 礼包购买信息
    exchanges 5 : *spar_laboratory_exchange(id) # 兑换信息
}








.birthday_customize_item {
    boxid           0 : integer   #格子id  
    items           1 : *item()
}

.birthday_reward_info { # 生日奖励数据
    year            0 : integer # 生日年
    stove_lv        1 : integer # 生日时的熔炉等级
    reward_id       2 : integer # 奖励id
    expire_time     3 : integer # 过期时间
    privilege_mark  4 : *pair_int_bool() # {[奖励类型]=true} 标示玩家当前有哪些奖励 奖励类型：1-免费 2-自选
    is_get          5 : *pair_int_bool() # 是否领取 奖励类型：1-免费 2-自选
    customize_item  6 : *birthday_customize_item() # 自选道具
}

.super_vip {
    join_time               0 : integer # 加入会员的时间
    join_reward_expire_time 1 : integer # 加入会员的奖励过期时间
    is_get_join_reward      2 : boolean # 是否领取加入奖励
    last_birthday_gift_time 3 : integer # 生日礼包上次触发时间
    next_birthday_gift_time 4 : integer # 下次生日礼包触发时间
    is_vip                  5 : boolean # 是否会员
}

.super_vip_set_info {
    is_set                  0 : boolean # 是否设置过 只要设置过 玩家无法修改生日和邮箱

    set_time                1 : integer # 设置的时间 只要不是同一天 设置次数就可以重置
    today_set_count         2 : integer # 今日设置次数

    .birthday_date {
        month               0 : integer
        day                 1 : integer
    }

    birthday                3 : birthday_date
    mail                    4 : string
    discord                 5 : string
    gender                  6 : integer # 1-男性 2-女性 3-第三性别
}


# 幸存者
.survivor {
    sid             0 : integer     # 工人id
    status          1 : integer     # 工人状态(空闲、工作、生病...)
    fid_source      2 : integer     # 工人绑定宿舍床位
    fid_work        3 : integer     # 工作工位家具id
    fid_ibed        4 : integer     # 医务室病床 bed
    cure_end_time   5 : integer     # 治疗结束时间
    img_id          6 : integer     # 形象id
    name_id         7 : integer     # 名字索引
    total_cure_time 8 : integer     # 生病总时间
    is_sick         9 : boolean     # 是否生病
}

.riot_data {
    start_time 0 : integer          # 暴动开始时间，一次都没暴动过是nil，暴动结束不会清
    detect_time 1 : integer         # 上次检测暴动时间，一次都没检测过是nil
}

.survivor_sick_result {
    sid             0 : integer     # 工人id
    fid_ibed        1 : integer     # 生病时如果有分配医院床位，则上传床位fid
    cure_end_time   2 : integer     # 生病时指定治疗结束时间
    total_cure_time 3 : integer     # 生病总时间
    health          4 : double      # 健康值（client_survivor_data.res607）
}



.target_integral_info {
    id 0 : integer # 活动ID
    start_ts 1 : integer         # 活动开始时间
    end_ts 2 : integer           # 活动结束时间
    integral 3 : integer         # 当前积分
    
    .received_mark {
        id 0 : integer # 奖励档位
        value 1 : boolean #是否被领取
    }
    received 4 : *received_mark() #已领取的奖励
    reward_conf_idx 5 : *integer #每个阶段奖励的配置ID(索引target_integral_reward表), 按阶段顺序排序, 1阶段的配置ID就是数组的第一个元素
    act_conf_id 6 : integer # 索引target_activity_conf
}


.td_box {
	box_id 0: integer
	pos 1 : point
	reward 2 : *item()
}


.td_event {
	event_id 0: integer					# 触发的事件id
	start_ts 1 : integer(0) 			# 开始时间
	end_ts 2 : integer(0)				# 结束时间
    quests 3 : *quest()             	# 未完成有进度的任务
	stage_id 4 : integer				# 关卡id
	start_stage_ts 5 : integer(0)		# 关卡开始时间
}

.td_survivor {
	type 0 : integer # 类型 1-战士 2-弓箭手
	sid 1 : *integer # 幸存者id
}


.td_troops {
	bld 0 : integer					# 建筑id
	hero_map 1 : *pair_int_int()	# {[位置]=英雄id}
}


.thanksgiving_bp_info {
    id 0 : integer                      # 活动ID
    start_ts 1 : integer                # 活动开启时间
    end_ts 2 : integer                  # 活动结束时间
    serial_no 3 : integer
    integral 4 : integer                # 当前积分

    group 5 : integer
    reward_group 6 : integer
    received_mark 7 : *received_mark()  # 已领取
    privilege_mark 8 : *mark()          # {[奖励类型]=true}, 用于判断某类型的奖励是否可以领取
}



.self_exchange {
    exchange_state 0 : integer  # 自己的交换状态 0：没有交换 1：交换中 2：交换完成，待领取
    sub_id 1 : integer          # 自己扣减的食材
    sub_num 2 : integer
    add_id 3 : integer          # 自己增加的食材
    add_num 4 : integer
    exchange_uid 5 : integer    # 交换的玩家
}

.self_exchange_info {
    exchange_id 0 : integer
    info 1 : self_exchange()
}

.thanksgiving_cooking_info {
    id 0 : integer              # 活动ID
    start_ts 1 : integer        # 活动开启时间
    end_ts 2 : integer          # 活动结束时间
    serial_no 3 : integer       # 期数
    food_adept 4 : *pair_int_bool()      # 菜品是否老手 [food_id] = true
    exchange_info 5 : *self_exchange_info()
}

.owner_exchange {
    sub_id 0 : integer          # 交换的玩家扣减的食材
    sub_num 1 : integer
    add_id 2 : integer          # 交换的玩家增加的食材
    add_num 3 : integer
}

.owner_exchange_info {
    exchange_id 0 : integer     # 交换id
    info 1 : owner_exchange()
}

.thanksgiving_cooking_exchange_info {
    owner 0 : integer
    info 1 : *owner_exchange_info()
}


.thanksgiving_feast_table { # 加餐
    uid 0 : integer # 加餐uid
    table_id 1 : integer # 餐桌的私有ID
    meal_id 2 : integer # 加餐类型ID
}

.thanksgiving_feast_alliance { # 联盟数据
    id 0 : integer # 宴会ID
    time 1 : integer(0) # 开启(预约开启)时间
    can_join 2 : boolean # 玩家能否加入(默认nil)
    tables 3 : *thanksgiving_feast_table # 加餐列表(默认nil)
    .point {
        x 0 : integer
        y 1 : integer
    }
    point 4 : point # 宴会坐标
}

.thanksgiving_feast_alliance_del_keys {
    point 0 : boolean
}

.thanksgiving_feast_activity { # 活动数据
    id 0 : integer              # 活动id
    stage_ts 1 : *integer(0)    # 活动阶段开始时间 1.预告,2.开启,3.展示,4.展示结束
	serial_no 2 : integer 		# 赛季
    buy_count 3 : *pair_int_int()  # 礼包购买数据
    gift_group_idx 4 : integer  # 礼包配置索引ID
    unread_record 5 : boolean # 是否有未读记录
}



.thanksgiving_menu_activity_info {  # 活动信息
    preview_start_ts 0 : integer        # 预告开始时间
    preview_end_ts 1 : integer          # 预告结束时间
    start_end_ts 2 : integer            # 活动结束时间
    final_end_ts 3 : integer            # 结算结束时间
    id 4 : integer                      # 活动ID
    integral 5 : integer                # 积分
    stage_type 6 : integer              # 阶段状态 1-展示 2-活动中 3-结算
    alliance_id 7 : integer             # 联盟ID 根据阶段有不同含义
    daily_integral 8 : integer          # 当天累计获得积分
    take_daily_chest 9 : boolean        # 是否已领取每日积分宝箱奖励
    dishes_group_id 10 : integer        # 急需菜单组id
}

.thanksgiving_menu_rank_info {  # 排行榜信息
    type 0 : integer # 排行榜类型 1-个人 2-联盟
    list_data 1 : *rank_data
    self_rank 2 : integer # 自身排名
    self_rank_data 3 : rank_data
}



.thanksgiving_sign_info {
    id 0 : integer                              # 活动ID
    start_ts 1 : integer                        # 活动开启时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer                       # 活动期数
    server_index 4 : integer                    # 索引thanksgivingday_sign配置表奖励
    last_sign_ts 5 : integer                    # 上次签到时间
    sign_days 6 : integer                       # 签到天数
    free_award_record 7 : *integer              # 免费领奖情况
    buy_award_record 8 : *integer               # 付费领取情况
    has_pay 9 : boolean                         # 是否付费
}

.received_sign_mark {
    day 0 : integer                             # 天数
    receive_type 1 : *pair_int_bool()           # 领取的奖励类型, 1免费, 2普通付费 
}


.three_tiles_task_info {
    finishs 0 : *finishs()                      # 已领奖任务
    quests 1 : *quest()                         # 进行中任务
}

.three_tiles_info {
    id 0 : integer                              # 活动ID
    start_ts 1 : integer                        # 活动开启时间
    end_ts 2 : integer                          # 活动结束时间
    serial_no 3 : integer

    pass_level 4 : *pair_int_bool()             # 通关关卡 {[level]=true}
    progress 5 : integer                        # 通关进度
    received_progress_reward 6 : *pair_int_bool()   # 已领取的通关进度奖励 {[progress]=true}

    task_info 7: three_tiles_task_info          # 任务数据   
    gift_group_arr 8: *integer                  # 礼包组

    challenge_level 9 : integer                 # 当前挑战的关卡
}

.level_data {
    key 0 : integer # 格子key(1000 * x + y)
    id 1 : integer  # 卡片id
}

.layer_level_data {
    layer 0 : integer
    data 1 : *level_data()
}

.select_data {
    key 0 : integer # 格子key(1000 * x + y)
    id 1 : integer  # 卡片id
    layer 2 : integer
    index 3 : integer # 唯一索引
}

.three_tiles_level {
    level 0 : integer
    use_free_items 1 : *pair_int_int()          # 使用免费道具和次数 {[item_id]=nums}
    level_data 2 : *layer_level_data()          # 关卡数据
    select_data 3 : *select_data                # 消除区域数据
    back_data 4 : *select_data                  # 回撤区域数据
    index 5 : integer                           # 唯一索引
}



.todo_item {
    item_type 0 : integer # 事项类型
    start_ts 1 : integer # 开始时间
    end_ts 2 : integer # 结束时间
}



.town_interaction_info {    
    shield_end_ts 0 : integer(0) #保护罩结束时间
    shield_cd_ts 1 : integer(0) #保护罩冷却结束时间戳
}


.triangle_war_stat {
    type 0 : integer
    count 1 : integer
}

.triangle_war_player {
    uid 0 : integer
    aid 1 : integer
    stat 2 : *triangle_war_stat()
}

.triangle_war_alliance {
    aid 0 : integer
    stat 1 : *triangle_war_stat()
    occupy_building 2 : *integer # 占领建筑id
}

.triangle_war_camp {
    camp 0 : integer
    aid 1 : integer
    kid 2 : integer
    abbr 3 : string
    aname 4 : string
    flag 5: integer
    flag_bg 6 : integer
    stat 7 : *triangle_war_stat()
}

.triangle_war_path_point {
    dst 0 : integer # 目标点id
    t 1 : integer # 行军时间毫秒
}

.triangle_war_march {
    id 0 : integer #队列唯一id
    owner 1 : integer # 玩家id

    startpointid 2 : integer # 移动开始建筑id
    endpointid 3 : integer # 当前所在建筑id、移动目标建筑id
    starttime 4 : integer(0) # 移动开始时间
    endtime 5 : integer(0) # 移动结束时间、复活结束时间
    path 6 : *triangle_war_path_point # 路径，不做增量更新

    state 7 : integer #状态
    squad_list 8 : triangle_war_formation   #出征小队信息用于表现 这个字段直接覆盖，不做增量更新
    camp 9 : integer # 阵营 1,2,3
    equiped_skin 10 : *skin_slat_detail(skintype)	# 装扮列表，不做增量更新
    power 11 : integer(0) # 战力
    formationid 12 : integer
    move_rate 13 : double # 当前已移动的比例
    origin_power 14: integer(0) # 满兵时的战力
}

.triangle_war_march_del_keys {
    startpointid 0 : boolean
    endpointid 1 : boolean
    starttime 2 : boolean
    endtime 3 : boolean
    path 4 : boolean
    move_rate 5 : boolean
}

.triangle_war_food_info { # 食物信息
    food_value 0 : integer           # 当前食物数量
    pre_recover_value 1 : integer    # 每秒恢复量
    last_time 2 : integer            # 上次恢复的时间
}

.triangle_war_player_info_by_appoint { # 玩家任命需要的显示信息
    uid 0 : integer             # uid 
    food_value 1 : integer      # 当前食物数量 
}

.triangle_war_player_map {
    camp 0 : integer
    uid_set 1 : *pair_int_bool()
}

.triangle_war_information_info { # 资讯信息
    .information_occupy { # 占领信息
        aid 0 : integer     # 联盟id
        bid 1 : integer     # 建筑id
    }

    .information_defense {          # 防守成功
        abbr 0 : string             # 联盟简称
        name 1 : string             # 玩家名字
        bid 2 : integer             # 建筑id
    }

    .information_tag {              # 标记
        type 0 : integer            # 标记类型
        bid 1 : integer             # 建筑id
    }

    type 0 : integer                                # 类型 1-占领 2-标记 3-防守成功
    id 1 : integer                                  # 资讯唯一id
    information_occupy 2 : information_occupy       # 占领资讯信息
    information_defense 3 : information_defense     # 防守成功
    information_tag 4 : information_tag             # 标记
    time 5 : integer                                # 时间
}

.triangle_war_building_battle_report { # 建筑战报信息
    time 0 : integer                        # 时间
    win 1 : boolean                         # 是否攻方胜利
    atk_uid 2 : integer                     # 攻击方玩家
    atk_formation_id 3 : integer            # 攻击方部队编号
    atk_abbr 4 : string                     # 攻击方联盟简介
    atk_camp 5 : integer                    # 攻击方阵营
    atk_power 6 : integer(0)                # 攻击方战力值
    atk_total_soldier_count 7 : integer(0)  # 攻击方总士兵数量
    atk_loss_soldier_count 8 : integer(0)   # 攻击方损失的士兵数量
    def_uid 9 : integer                     # 防守方玩家
    def_formation_id 10 : integer           # 防守方部队编号
    def_abbr 11 : string                    # 防守方联盟简介
    def_camp 12 : integer                   # 防守方阵营
    def_power 13 : integer(0)               # 防守方战力值
    def_total_soldier_count 14 : integer(0) # 防守方总士兵数量
    def_loss_soldier_count 15 : integer(0)  # 防守方损失的士兵数量
    def_is_npc 16 : boolean                 # 防守方是否是npc
    report_id 17 : integer                  # 战报id
}

.triangle_war_formation_hero {
    pos 0 : integer
    id 1 : integer      # 英雄id
    lv 2 : integer      # 等级
    training_lv 3 : integer # 训练营等级
    star 4 : integer    # 星级
}

.triangle_war_soldier {
    id 0 : integer      # 士兵id
    count 1 : integer   # 数量
}

.triangle_war_formation {
    hero 0 : *triangle_war_formation_hero(pos)    # 英雄
    soldier 1 : *triangle_war_soldier(id)           # 士兵
}







.value_exchange {
    id 0 : integer                  # 活动id
    preview_ts 1 :integer(1)        # 预览开始时间
    start_ts 2 : integer(1)         # 活动开始时间
    end_ts 3 : integer(1)           # 活动结束时间
	exchange_data 4 : *pair_int_int() # 兑换情况 [物品索引]=已兑换数量
    version 5:integer #组id
    is_free_exchange 6 : boolean #免费兑换标记
}



.version_up_activity { 	# 对象
    id 0 : integer # 活动ID
	starttime 1 : integer # 开始时间
	endtime 2 : integer # 结束时间
    rewards 3 : *integer # 更新奖励 # {id,count,id,count,...}
    .platform_version {
        id 0 : integer # 平台ID 1.apple 2.google
        version 1 : string # 版本号
    }
    versions 4 : *platform_version(id) # 平台对应版本号
}



.vip_data {
    vip_lv 0 : integer      # vip等级
    vip_exp 1 : integer     # vip经验
    vip_active_endtime 2 : integer      # vip激活 结束时间
    get_daily_exp_ts 3 : integer        # 每日vip经验领取时间
    get_daily_gift_ts 4 : integer       # 每日免费礼物领取时间
    uncollected_daily_gift 5 : *pair_int_int() # 未收取的每日免费礼物，只有非当前等级的部分，当前等级的判断照旧
}



.puzzle_info {
    nums 0 : integer
    is_award 1 : boolean
    suit_id 2 : integer
}

.vip_puzzle_info {
    type 0 : integer
    info 1 : puzzle_info
}

.vip_lottery_info {
    grid_id 0 : integer
    is_replace 1 : boolean
}

.vip_privilege_info {
    is_unlock 0 : boolean                               # 是否解锁尊享特权
    is_turntable_free 1 : boolean                       # 是否使用了免费转盘
    replace_grid_info 2 : *pair_int_bool()              # 转盘替换的格子{[grid_id]=true}
    puzzle_info 3 : *vip_puzzle_info()                  # 拼图数据
}


.burn_data { # 燃烧信息
    starttime 0 : integer # 开始时间(上次结算时间)
    endtime 1 : integer # 结束时间
    speed 2 : integer(4) # 燃烧速度
}




.map_expression {
    expression_id 0 : integer # 地图表情id
    expression_time 1 : integer # 地图表情广播时间
}

.map_aura_info {
    id 0 : integer # 氛围ID
    end_ts 1 : integer(0) # 氛围效果结束时间
}

.point {
    x 0 : integer
    y 1 : integer
}

.point_double {
    x 0 : double
    y 1 : double
}

.map_alliance_building_detail {
    aid 0 : integer                 # 归属联盟id
    id 1 : integer                  # 建筑唯一id
    territory_active 2 : boolean    # 领地是否激活，部分建筑没这个属性
    build_finish 3 : boolean        # 是否建造完成
    build_start_ts 4 : integer      # 建造开始时间
    build_finish_ts 5 : integer     # 建造完成时间
    occupy_aid 6 : integer          # 占领者联盟id
    hp 7 : double                   # 当前血量浮点数
    conf_id 8 : integer             # 建筑配置id
    abbr 9 : string                 # 归属联盟简称
    max_hp 10 : integer             # 最大血量
    border_active 11 : boolean      # 只在建造未完成时使用，是否接壤已激活领地
}

.world_mapobj {
    .map_city {
        uid 0 : integer
        lv 1 : integer
        nickName 2 : string
        aid 3 : integer
        abbr 4 : string
        burn_endtime 5 : integer #燃烧结束时间
        smoke_endtime 6 : integer #冒烟结束时间
        shield_endtime 7 : integer #保护罩结束时间
        cur_help_num 8 : integer #联盟援助数量
        equiped_skin 9 : *skin_slat_detail(skintype)	# 装扮列表
        office 10 : integer # 官职
        arsenal_war_lock_endtime 11 : integer # arsenal_war 战场锁定结束时间
        kid 12 : integer        # 王国id
        frostfire_war_lock_endtime 13 : integer # frostfire_war 战场锁定结束时间

	}
	response {
		code 0 : integer
        #award 1 : *item() #实际奖励物品（被装换完） 
        #show_reward  1 : *hero_search_show_reward() #奖池抽出map
        hero_change_map 1 : *hero_change_map()  #被装换成碎片的英雄map
        search_time 2: *search_time() #搜索时间
        reward_before_change 3 : *item() # 碎片装换前的奖励map（ 多抽读取 ）
        sort_reward 4 : *hero_search_show_reward()  #显示奖励 （ 单抽读取 ）
        free_search_times 5 : integer #高级搜索免费搜索次数
        #dropid 4 :  integer #掉落ID 
	}
}





